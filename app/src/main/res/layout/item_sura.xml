<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingVertical="8dp"
    >

    <TextView
        android:id="@+id/suraNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="1"
        style="@style/bodyMedium"
        android:background="@drawable/surah_number_container"
        android:gravity="center"
        />
    <TextView
        android:id="@+id/suraNameEn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Al-Fatiha"
        style="@style/bodyMedium"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/suraNumber"
        android:layout_marginStart="24dp"
        />
    <TextView
        android:id="@+id/suraVerses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="7 Verses"
        style="@style/bodySmall"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/suraNameEn"
        app:layout_constraintStart_toStartOf="@id/suraNameEn"
        android:layout_marginTop="8dp"
        />
    <TextView
        android:id="@+id/suraNameAr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="الفاتحة"
        style="@style/bodyMedium"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/suraVerses"
        android:layout_marginTop="8dp"
        />
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintWidth_percent=".7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/suraVerses"
        android:background="@color/white"
        android:layout_marginTop="10dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>