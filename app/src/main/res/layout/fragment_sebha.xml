<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.scrrens.main.fragments.sebha.SebhaFragment"
    android:background="@drawable/sebha_bg">

    <ImageView
        android:id="@+id/islamiLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/islami_logo"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/sebhaHead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sebha_head"
        app:layout_constraintTop_toBottomOf="@id/islamiLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/sebhaBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sebha_body"
        app:layout_constraintTop_toBottomOf="@id/sebhaHead"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/sebhaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/sebhaBody"
        app:layout_constraintBottom_toBottomOf="@id/sebhaBody"
        app:layout_constraintStart_toStartOf="@id/sebhaBody"
        app:layout_constraintEnd_toEndOf="@id/sebhaBody"
        android:gravity="center"
        tools:text="سبحان الله"
        style="@style/bodyLarge"
        />
    <TextView
        android:id="@+id/sebhaNum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/sebhaText"
        app:layout_constraintStart_toStartOf="@id/sebhaBody"
        app:layout_constraintEnd_toEndOf="@id/sebhaBody"
        android:gravity="center"
        tools:text="33"
        style="@style/bodyLarge"
        android:layout_marginTop="8dp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>